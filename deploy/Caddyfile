steto.tech {
  encode gzip
  request_body {
    max_size 50MB
  }
  handle /api/* {
    reverse_proxy api:8000
  }
  handle {
    reverse_proxy web:3000
  }
}

www.steto.tech {
  redir https://steto.tech{uri} permanent
}

http://localhost {
  handle /api/* {
    reverse_proxy api:8000
  }
  handle {
    reverse_proxy web:3000
  }
}
